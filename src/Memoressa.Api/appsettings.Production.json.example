{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_RDS_ENDPOINT.region.rds.amazonaws.com;Port=5432;Database=memoressa;Username=memoressa;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_LONG_RANDOM_SECRET"
  },
  "AwsS3": {
    "Region": "ap-southeast-1",
    "BucketName": "your-private-uploads-bucket"
  },
  "InternalApi": {
    "ApiKey": "REPLACE_WITH_INTERNAL_API_KEY"
  }
}
